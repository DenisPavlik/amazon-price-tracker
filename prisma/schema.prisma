// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id                   Int      @id @default(autoincrement())
  userEmail            String
  amazonId             String
  title                String
  img                  String
  price                Int
  reviewsCount         Int
  reviewsAverageRating Int
  targetPrice          Int?
  lowestPrice          Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  notifications Notification[]

  @@unique([amazonId, userEmail])
}

model ProductDataHistory {
  id                   Int      @id @default(autoincrement())
  amazonId             String
  title                String
  img                  String
  price                Int
  reviewsCount         Int
  reviewsAverageRating Int
  createdAt            DateTime @default(now())

  @@index([amazonId, createdAt(sort: Desc)])
}

enum NotificationKind {
  PRICE_DROP
  TARGET_HIT
}

model Notification {
  id        Int              @id @default(autoincrement())
  userEmail String
  amazonId  String
  title     String
  kind      NotificationKind @default(PRICE_DROP)
  priceFrom Int?
  priceTo   Int?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  productId Int?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([userEmail, isRead])
  @@index([userEmail, createdAt(sort: Desc)])
}
